# Pocket gateway: private settings for one machine. This tracked file holds placeholders only.
#
# Copy it to a private location outside Git with the no-overwrite command in
# bridge/deploy/README.md (never over an existing file), keep the copy owner-only (mode
# 0600) and replace the active <placeholder> values. After pairing, attaching and
# binding, start from this checkout's bridge/ directory using the gateway venv:
#   "$PET_PYTHON" -B -m pet_bridge serve --env-file "/ABSOLUTE/PATH/.env"
# Never commit or share the filled-in copy. Do not edit it while the gateway is starting.
#
# Format: NAME=value, one per line; the value is literal text to the end of the line.
# No quotes, no spaces around "=", no "export", no inline comments, Unix line endings.
# An unknown, repeated, empty or malformed entry stops the gateway before it listens.

# Format version of these settings; keep 1.
POCKET_GATEWAY_CONFIG_VERSION=1

# Absolute private state directory created by pairing (owner-only, mode 0700).
POCKET_GATEWAY_STATE_ROOT=<absolute-XDG_CONFIG_HOME>/amplifier-unified-pet-bridge

# Optional: absolute directory of existing credentials; default is "auth" in the state directory.
#POCKET_GATEWAY_AUTH_ROOT=<absolute-private-auth-directory>

# Credential reference printed by pair-poll ("device-" followed by 32 hex characters).
POCKET_GATEWAY_CREDENTIAL_REF=<pair-poll-credential-reference>

# Full id of the bound Unified conversation.
POCKET_GATEWAY_SESSION_ID=<full-pinned-front-door-chat-id>

# Short display label of that conversation (at most 40 characters).
POCKET_GATEWAY_SESSION_LABEL=Pocket assistant

# LAN IPv4 address of this host to listen on (a private-range address, never a wildcard).
POCKET_GATEWAY_BIND_HOST=<server-lan-ipv4>

# TLS port to listen on (1024 to 65535).
POCKET_GATEWAY_PORT=9443

# Exact HTTP Host value the pet sends: the same LAN IPv4 and port.
POCKET_GATEWAY_HOST_HEADER=<server-lan-ipv4>:9443

# Optional: Tailscale IPv4 of this host for a second listener (set both Tailnet values or neither).
#POCKET_GATEWAY_TAILNET_BIND_HOST=<server-tailscale-ipv4>

# Optional: lowercase certificate FQDN the pet uses over the Tailnet.
#POCKET_GATEWAY_TAILNET_FQDN=<gateway-certificate-fqdn>

# Absolute path of the owner-only TLS certificate chain file.
POCKET_GATEWAY_TLS_CERT_FILE=<absolute-private-certificate-chain-path>

# Absolute path of the owner-only TLS key file.
POCKET_GATEWAY_TLS_KEY_FILE=<absolute-private-certificate-key-path>

# Lowercase SHA-256 hex of each allowed pet token; separate several with commas, no spaces.
POCKET_GATEWAY_PET_TOKEN_SHA256=<lowercase-sha256-of-pet-token-ascii>

# Optional: voice model name; default gpt-live-1.
#POCKET_GATEWAY_MODEL=gpt-live-1

# Optional: voice name; default marin.
#POCKET_GATEWAY_VOICE=marin

# Provider key, choice 1 of 2 (set exactly one): absolute path of an owner-only key file.
POCKET_GATEWAY_PROVIDER_KEY_FILE=<absolute-private-openai-key-path>

# Provider key, choice 2 of 2 (set exactly one): the key itself, kept only in the private copy.
#POCKET_GATEWAY_PROVIDER_KEY=<openai-api-key>
