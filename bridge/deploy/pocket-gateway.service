[Unit]
Description=Pocket voice gateway for Amplifier Unified
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@BRIDGE_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
# Recommended: settings come from a private owner-only .env file that the gateway reads
# and checks itself. Do not add EnvironmentFile=: it would skip that check and export the
# file's secrets into the process environment.
ExecStart=@PYTHON@ -B -m pet_bridge serve --env-file "@ENV_FILE@" --event-log "@EVENT_LOG@"
# Alternative: a private JSON config. Use this line INSTEAD of the one above, never both.
#ExecStart=@PYTHON@ -B -m pet_bridge serve --config "@CONFIG@" --event-log "@EVENT_LOG@"
Restart=on-failure
RestartSec=10s
UMask=0077
# Allow session close and the bounded host HTTP operation to settle before SIGKILL.
TimeoutStopSec=240s

[Install]
WantedBy=default.target